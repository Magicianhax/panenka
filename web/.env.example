# X Layer chain — 195 testnet, 196 mainnet
NEXT_PUBLIC_CHAIN_ID=195

# Address of deployed PenaltyMatch contract
NEXT_PUBLIC_PENALTY_MATCH_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Project ID — get from https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Ably API key (SERVER-SIDE ONLY — no NEXT_PUBLIC prefix). Enables cross-device
# crowd/player chat. Leave empty to fall back to single-device BroadcastChannel.
ABLY_API_KEY=
